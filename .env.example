# Model string accepted by langchain.chat_models.init_chat_model.
# Examples: openai:gpt-4.1-mini, openai:mimo-v2.5-pro, anthropic:claude-3-5-sonnet-latest
STOCK_LEARN_MODEL=openai:mimo-v2.5-pro

# Required for OpenAI-compatible models.
OPENAI_API_KEY=

# Optional: set when using an OpenAI-compatible gateway.
OPENAI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
OPENAI_API_BASE=https://token-plan-cn.xiaomimimo.com/v1

# Required for Tavily search.
TAVILY_API_KEY=

# Local private DB. This path is intentionally gitignored.
STOCK_LEARN_DB=data/private/stock_learn.sqlite
STOCK_LEARN_USER_ID=default
STOCK_LEARN_THREAD_ID=default
